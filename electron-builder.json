{
  "appId": "com.transcription-with-correction.app",
  "productName": "Transcription Correction",
  "directories": {
    "output": "out"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "extraResources": [
    {
      "from": "swift-helper/SpeechHelper/.build/release/SpeechHelper",
      "to": "SpeechHelper"
    },
    {
      "from": "swift-helper/SpeechHelper/.build/release/AutomationHelper",
      "to": "AutomationHelper"
    },
    {
      "from": "build/tray-icon.png",
      "to": "tray-icon.png"
    }
  ],
  "mac": {
    "target": "dmg",
    "category": "public.app-category.productivity",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "音声入力機能でマイクを使用します。",
      "NSSpeechRecognitionUsageDescription": "音声認識機能を使用して文字起こしを行います。",
      "NSAppleEventsUsageDescription": "直前に使用していたアプリへ戻り、校正結果を貼り付けるために使用します。"
    }
  }
}
